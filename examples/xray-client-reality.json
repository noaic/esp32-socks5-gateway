{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "tag": "esp32-dns-upstream",
    "servers": [
      {
        "address": "https+local://dns.alidns.com/dns-query",
        "domains": ["geosite:cn"]
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": ["geosite:geolocation-!cn"]
      },
      "localhost"
    ],
    "queryStrategy": "UseIPv4",
    "disableCache": false,
    "disableFallback": false
  },
  "inbounds": [
    {
      "tag": "esp32-socks",
      "listen": "0.0.0.0",
      "port": 7897,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "<LAN_IPV4>"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "<REMOTE_ADDRESS>",
            "port": 443,
            "users": [
              {
                "id": "<VLESS_UUID>",
                "encryption": "none",
                "flow": "xtls-rprx-vision-udp443"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "serverName": "<REALITY_SERVER_NAME>",
          "publicKey": "<REALITY_PUBLIC_KEY>",
          "shortId": "<REALITY_SHORT_ID>"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "esp32-dns",
      "protocol": "dns",
      "settings": {
        "nonIPQuery": "skip"
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["esp32-socks"],
        "network": "tcp,udp",
        "port": "53",
        "outboundTag": "esp32-dns"
      },
      {
        "type": "field",
        "inboundTag": ["esp32-dns-upstream"],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["geosite:cn"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:cn"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": ["esp32-socks"],
        "outboundTag": "proxy"
      }
    ]
  }
}
