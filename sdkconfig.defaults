CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
# Release the bounded Wi-Fi RX buffers before lwIP/socket queues retain data.
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_PROXY_POC_ENABLE=y
CONFIG_PROXY_POC_TEST_IP="198.51.100.7"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_PROXY_TCP_SOCKS5=y
CONFIG_LWIP_SO_LINGER=y

CONFIG_PROXY_UDP_ENABLE=y
CONFIG_LWIP_MAX_SOCKETS=208
CONFIG_LWIP_MAX_UDP_PCBS=40

# 64 TCP relays * 2 + 32 UDP controls, plus accepted/closing/TIME_WAIT PCBs.
# This changes the allocation ceiling, not the 64-session application limit.
CONFIG_LWIP_MAX_ACTIVE_TCP=256

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16

CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48

CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y

CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32

CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32

CONFIG_ESP_WIFI_TX_BA_WIN=16

CONFIG_ESP_WIFI_RX_BA_WIN=16

# Keep the working baseline aggregation after the RX-off compatibility regression.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=17280

CONFIG_LWIP_TCP_WND_DEFAULT=23040

CONFIG_LWIP_TCP_RECVMBOX_SIZE=18
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=16
CONFIG_VFS_SUPPORT_SELECT=y
CONFIG_LWIP_USE_ONLY_LWIP_SELECT=n

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=48


CONFIG_FREERTOS_HZ=1000

# Cache performance experiment: consumes an additional 48 KiB internal RAM.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
# Used only when runtime statistics are enabled, e.g. by verbose diagnostics.
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

# Temporary AP-local throughput endpoint; enable only for diagnosis.
CONFIG_PROXY_LINK_BENCH=n
CONFIG_PROXY_PIPELINE_DIAG=n
CONFIG_PROXY_VERBOSE_DIAGNOSTICS=n
CONFIG_PROXY_LINK_PROBE=n
